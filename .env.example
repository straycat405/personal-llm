# docker compose가 루트 디렉터리에서 자동으로 읽는 환경변수 파일 템플릿.
#   cp .env.example .env
# .env는 .gitignore 대상 — 실제 값을 커밋하지 말 것.

# [필수] JWT 서명 키. 미설정 시 `docker compose up`이 기동 자체를 거부한다(안전 실패).
#   생성: openssl rand -base64 32
#   32바이트(256비트) 미만이거나 "changeme" 등 알려진 placeholder면 백엔드가 기동 실패한다.
JWT_SECRET=

# [필수] PostgreSQL 비밀번호. db·backend 두 서비스가 같은 값을 공유한다.
#   생성: openssl rand -base64 24
POSTGRES_PASSWORD=

# [필수] Grafana admin 계정 비밀번호. 기존 admin/admin 고정 계정을 대체한다.
#   생성: openssl rand -base64 18
GRAFANA_ADMIN_PASSWORD=
